<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Animation.Trace.DialogWindow" parent="@android:style/Animation">
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
    </style>

    <style name="Theme.Trace.Dialog" parent="android:Theme.DeviceDefault.Dialog">
        <item name="android:windowAnimationStyle">@style/Animation.Trace.DialogWindow</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
    </style>

    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:dialogTheme">@style/Theme.Trace.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.Trace.Dialog</item>
    </style>

    <style name="Theme.Trace.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">#DBE7FD</item>
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>
</resources>
